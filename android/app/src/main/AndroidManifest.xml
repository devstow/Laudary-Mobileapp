<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Map pin picker: "use my current location" (geolocator) + OSM tiles. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Driver live tracking: geolocator's location FOREGROUND SERVICE (declared by geolocator_android with
         foregroundServiceType="location") keeps GPS updates flowing while the app is in the background, with an
         ongoing "on duty" notification. Started while the app is open with "while in use" location permission,
         so ACCESS_BACKGROUND_LOCATION is deliberately NOT requested. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+: lets the ongoing tracking notification appear in the shade (the service runs either way). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ForegroundNotificationConfig.enableWakeLock: keeps the CPU awake for fixes while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Plain http:// (local API at 10.0.2.2) is allowed ONLY in debug/profile builds: see
             src/debug/AndroidManifest.xml. Release builds talk HTTPS to the staging/production API,
             so Android's default (cleartext blocked) applies and nothing else needs configuring. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Shares documents saved on Android 7–9 (receipt PDFs) with the viewer app; Android 10+ uses
             MediaStore content URIs instead. See MainActivity.kt (channel smartwash/downloads). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher (Android 11+ package visibility): without these, canLaunchUrl()
             returns false and the Call / Navigate / open-in-maps buttons silently do nothing. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- Open downloaded receipt PDFs in the user's viewer (MainActivity.openFile). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>
</manifest>
